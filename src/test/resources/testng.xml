<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">
<suite name="Online Banking System Test Suite" parallel="classes" thread-count="1">
    <listeners>
        <listener class-name="org.testng.reporters.TestHTMLReporter"/>
        <listener class-name="org.testng.reporters.SuiteHTMLReporter"/>
        <listener class-name="org.testng.reporters.EmailableReporter"/>
    </listeners>

    <test name="User Registration Tests" preserve-order="true">
        <classes>
            <class name="com.userfront.testcases.UserRegistrationTest"/>
        </classes>
    </test>

    <test name="User Login Tests" preserve-order="true">
        <classes>
            <class name="com.userfront.testcases.UserLoginTest"/>
        </classes>
    </test>

    <test name="Account Management Tests" preserve-order="true">
        <classes>
            <class name="com.userfront.testcases.AccountManagementTest"/>
        </classes>
    </test>

    <test name="Transfer Tests" preserve-order="true">
        <classes>
            <class name="com.userfront.testcases.TransferTest"/>
        </classes>
    </test>

    <test name="Appointment Tests" preserve-order="true">
        <classes>
            <class name="com.userfront.testcases.AppointmentTest"/>
        </classes>
    </test>

    <test name="Admin Tests" preserve-order="true">
        <classes>
            <class name="com.userfront.testcases.AdminTest"/>
        </classes>
    </test>

    <!-- API Tests -->
    <test name="REST API - User Management Tests" preserve-order="true">
        <classes>
            <class name="com.userfront.api.UserApiTest"/>
        </classes>
    </test>

    <test name="REST API - Appointment Tests" preserve-order="true">
        <classes>
            <class name="com.userfront.api.AppointmentApiTest"/>
        </classes>
    </test>

    <test name="Authentication and Authorization Tests" preserve-order="true">
        <classes>
            <class name="com.userfront.api.AuthApiTest"/>
        </classes>
    </test>

    <test name="Public Endpoint Tests" preserve-order="true">
        <classes>
            <class name="com.userfront.api.PublicEndpointTest"/>
        </classes>
    </test>

    <test name="Authenticated Endpoint Tests" preserve-order="true">
        <classes>
            <class name="com.userfront.api.AuthenticatedEndpointTest"/>
        </classes>
    </test>

    <test name="Admin Endpoint Tests" preserve-order="true">
        <classes>
            <class name="com.userfront.api.AdminEndpointTest"/>
        </classes>
    </test>

    <test name="Parameter Validation Tests" preserve-order="true">
        <classes>
            <class name="com.userfront.api.ParameterValidationTest"/>
        </classes>
    </test>

    <test name="Response Format Tests" preserve-order="true">
        <classes>
            <class name="com.userfront.api.ResponseFormatTest"/>
        </classes>
    </test>

</suite>
